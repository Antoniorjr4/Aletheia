module tf
type Op = | Pay { to: Text[..16], memo: Text[..16] }
type Plan = | Plan { ops: List[Op, 0..3] }
model planner { price_in = 0.0  price_out = 0.0  ctx = 8192  max_out = 4000  reasoning = 0  ttft = 1.0  per_tok = 0.01 }
tool pay(c: Cap[Bank.Pay], to: Text ^ Endorsed, memo: Text ^ Endorsed) -> Unit ! { Bank.Pay } irrevocable latency 1.0
  requires s.member("payees", to)
tool echo(c: Cap[Bank.Pay], x: Text) -> Text ! { Bank.Pay } reversible latency 1.0
tool pub(c: Cap[Bank.Pay], x: Text ^ Public) -> Unit ! { Bank.Pay } reversible latency 1.0
tool pay2(c: Cap[Bank.Pay], to: Text ^ Endorsed) -> Unit ! { Bank.Pay } reversible latency 1.0
tool echot(c: Cap[Bank.Pay], x: Text) -> Text ^ Trusted ! { Bank.Pay } reversible latency 1.0
tool echou(c: Cap[Bank.Pay], x: Text) -> Text ^ Untrusted ! { Bank.Pay } reversible latency 1.0
policy Q(o: Op) -> Bool = match o { Pay { to } => s.member("payees", to) }
policy P(p: Plan) -> Bool = true
agent A(bank: Cap[Bank.Pay]) budget [tok <= 10000, usd <= 1.0, wall <= 100.0] {
  on go(req: Text[..200] ^ Trusted, web: Text[..16] ^ Untrusted, sec: Text[..16] ^ Secret) -> Text ! { Infer, Bank.Pay } {
    let d = infer planner -> Plan { request = req, payees = s.inventory("payees") }
    let p = refine d by P keeping ops by Q as fora else { return "none" }
    match p { Plan { ops } => for a in ops { for b in ops { match a { Pay { to } => match b { Pay { memo } => {
 let m = echo(bank, memo)
 commit pay(bank, to, m) } } } } } }
    "ok"
  }
}
