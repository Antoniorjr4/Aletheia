+-- Em ordem: no máximo 2 Send por plano, os dois primeiros propostos; o destinatário de um Send
+-- é conferido por SafeWrite na execução.
+policy SafeOp(w: Write, accepted: List[Write, 0..4]) -> Bool =
+  match w {
+    Send { .. } => (sum a in accepted => match a { Send { .. } => 1, _ => 0 }) < 2,
+    _ => true,
+  }
