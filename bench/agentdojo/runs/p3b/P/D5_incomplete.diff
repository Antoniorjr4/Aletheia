+# Conjunto básico latino do SEPA: letras ASCII, dígitos, espaço e / - ? : ( ) . , ' +
+SEPA = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 /-?:().,'+")
+
+
+def sepa_text(t: str) -> bool:
+    """Aceito exatamente como proposto ou recusado; vazio é aceito."""
+    return all(c in SEPA for c in t)
+
