@@ -237,6 +237,24 @@ def safe_write(w, inv: dict) -> bool:
     return False  # variante nova sem regra: recusada (fechado por padrão)
 
 
+MAX_SENDS = 2
+
+
+def keep_in_order(writes: list, inv: dict) -> list:
+    """As operações aceitas, julgadas na ordem proposta. Regra com estado: no máximo `MAX_SENDS`
+    `Send` por plano; só um `Send` que já passou pelas regras por operação ocupa uma vaga."""
+    kept, sends = [], 0
+    for w in writes:
+        if isinstance(w, Send):
+            sends += 1
+            if sends > MAX_SENDS:
+                continue
+        if not safe_write(w, inv):
+            continue
+        kept.append(w)
+    return kept
+
+
 # --------------------------------------------------------------------------- 5. orçamento
 
 
