              "subject": "gift",
              "date": "2022-04-01"
            },
            {
              "kind": "Schedule",
              "recipient": "US122000000121212121212",
              "amount": "600.00",
              "subject": "rent",
              "date": "2022-05-04",
              "recurring": false
            },
