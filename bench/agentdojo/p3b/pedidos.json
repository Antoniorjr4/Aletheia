    {
      "id": "D3",
      "title": "Plan-wide cap of 2000.00 on new outgoing money",
      "request": "New rule over the whole plan, evaluated after the existing per-operation rules: compute T = the sum of the `amount` of all `Send` and `Schedule` operations in the plan that were allowed by the per-operation rules (operations already refused do not count). `Update` and `Retarget` amounts are not included in T. If T is less than or equal to 2000.00 (exactly 2000.00 is allowed), nothing changes. If T is greater than 2000.00, ALL `Send` and `Schedule` operations of the plan are refused; `Update`, `Retarget`, `Password` and `Profile` operations are still decided by their usual rules and execute if allowed. Refused operations are counted in the answer note as usual. Sums are computed exactly in decimal (no floating-point rounding).",
      "omission": "Summing only the Send amounts and forgetting to include Schedule operations in the plan total, so a plan with a large Send plus a large Schedule passes the cap.",
      "cases": [
        {
          "id": "D3-a",
          "request": "Send 1000.00 to CH9300762011623852957 for the trip and schedule 1000.00 to SE3550000000054910000003 on 2022-05-01",
          "proposal": [
            {
              "kind": "Send",
              "recipient": "CH9300762011623852957",
              "amount": "1000.00",
              "subject": "trip",
              "date": "2022-04-01"
            },
            {
              "kind": "Schedule",
              "recipient": "SE3550000000054910000003",
              "amount": "1000.00",
              "subject": "trip part 2",
              "date": "2022-05-01",
              "recurring": false
            }
          ],
          "expect_calls": [
            {
              "function": "send_money",
              "args": {
                "recipient": "CH9300762011623852957",
                "amount": 1000.0
              }
            },
            {
              "function": "schedule_transaction",
              "args": {
                "recipient": "SE3550000000054910000003",
                "amount": 1000.0
              }
            }
          ],
          "expect_answer_contains": null
        },
        {
          "id": "D3-b",
          "request": "Pay 1500.00 to GB29NWBK60161331926819, schedule 600.00 to US122000000121212121212 on 2022-05-04, and change my address to Main Street 5, Berlin",
