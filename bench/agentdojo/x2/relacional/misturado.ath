module relacional
type Op = | Send { recipient: Text[..34], amount: Text[..16] }
type Plan = | Plan { writes: List[Op, 0..4] }
model planner { price_in = 0.0  price_out = 0.0  ctx = 8192  max_out = 4000  reasoning = 0  ttft = 1.0  per_tok = 0.01 }
-- o contrato confere a RELAÇÃO destinatário–valor numa lista confiável, na fronteira do efeito
tool send_money(c: Cap[Bank.Transfer], recipient: Text[..34] ^ Endorsed, amount: Text[..16] ^ Endorsed) -> Text
  ! { Bank.Transfer } irrevocable latency 1.0
  requires s.binds("allowed", recipient, amount)
-- a política, como na base do M4, só confere o destinatário
policy SafeWrite(w: Op) -> Bool = match w { Send { recipient } => s.member("payees", recipient) }
policy SafePlan(p: Plan) -> Bool = true
agent A(bank: Cap[Bank.Transfer]) budget [tok <= 10000, usd <= 1.0, wall <= 100.0] {
  on task(request: Text[..200] ^ Trusted) -> Text ! { Infer, Bank.Transfer } {
    let d = infer planner -> Plan { request = request, payees = s.inventory("payees") }
    let plan = refine d by SafePlan keeping writes by SafeWrite as fora else { return "none" }
    match plan { Plan { writes } => {
      -- X2: o destinatário de uma operação aprovada e o valor de outra
      for w in writes { match w { Send { recipient } =>
        for w2 in writes { match w2 { Send { amount } => commit send_money(bank, recipient, amount) } } } }
      "ok" } }
  }
}
