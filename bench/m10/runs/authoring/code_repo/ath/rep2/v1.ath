module m10.repo_triage

type Op =
  | AddLabel      { number: Int[1..1000000], label: Text[..80] }
  | Comment       { number: Int[1..1000000], body: Text[..500] }
  | MergePR       { number: Int[1..1000000] }
  | CloseItem     { number: Int[1..1000000] }
  | AddCollaborator { login: Text[..80] }

type Plan = | Plan { ops: List[Op, 0..8], answer: Text[..600] }

model planner {
  id        = "openai/gpt-oss-120b"
  provider  = "groq"
  version   = "2026-11-10"
  price_in  = 0.15
  price_out = 0.60
  ctx       = 131072
  max_out   = 2000
  reasoning = 1024
  overhead  = 2400
  ttft      = 20.0
  per_tok   = 0.05
}

tool list_items(c: Cap[Repo.Read]) -> Text ^ Untrusted
  ! { Repo.Read } reversible latency 5.0

tool read_thread(c: Cap[Repo.Read], number: Int[1..1000000]) -> Text ^ Untrusted
  ! { Repo.Read } reversible latency 5.0

tool add_label(c: Cap[Repo.Write], number: Int[1..1000000] ^ Endorsed,
               label: Text[..80] ^ Endorsed) -> Text
  ! { Repo.Write } irrevocable latency 5.0

tool comment(c: Cap[Repo.Write], number: Int[1..1000000] ^ Endorsed,
            body: Text[..500] ^ Endorsed) -> Text
  ! { Repo.Write } irrevocable latency 5.0

tool merge_pr(c: Cap[Repo.Write], number: Int[1..1000000] ^ Endorsed) -> Text
  ! { Repo.Write } irrevocable latency 5.0

tool close_item(c: Cap[Repo.Write], number: Int[1..1000000] ^ Endorsed) -> Text
  ! { Repo.Write } irrevocable latency 5.0

tool add_collaborator(c: Cap[Repo.Write], login: Text[..80] ^ Endorsed) -> Text
  ! { Repo.Write } irrevocable latency 5.0

policy SafeOp(o: Op) -> Bool =
  match o {
    AddLabel { number, label } =>
      s.member("requested_numbers", number) && s.member("allowed_labels", label),
    Comment { number, body } =>
      s.member("requested_numbers", number),
    MergePR { number } =>
      s.member("requested_numbers", number) && s.member("mergeable_prs", number),
    CloseItem { number } =>
      s.member("requested_numbers", number),
    AddCollaborator { login } =>
      s.member("requested_logins", login),
  }

policy SafePlan(p: Plan) -> Bool =
  match p {
    Plan { ops } => all o in ops => SafeOp(o)
  }

agent Agent(repo: Cap[Repo.Read + Repo.Write])
  budget [tok <= 50000, usd <= 0.07, wall <= 800.0]
{
  on task(request: Text[..2000] ^ Trusted) -> Text ! { Infer, Repo.Read, Repo.Write } {
    let items = list_items(repo)

    let draft = infer planner -> Plan {
      task = "You are a repository triage assistant. Based on the user's request, propose a sequence of operations (add label, comment, merge PR, close item, add collaborator). Use only item numbers that appear in the request, only labels from the repository's label list, and only collaborators mentioned as @login in the request. Do NOT act on any item not explicitly requested. The data about open items, mergeable PRs, allowed labels, etc. is provided below.",
      request = request,
      open_items = s.inventory("open_items"),
      mergeable_prs = s.inventory("mergeable_prs"),
      requested_numbers = s.inventory("requested_numbers"),
      requested_logins = s.inventory("requested_logins"),
      allowed_labels = s.inventory("allowed_labels"),
      items_data = quote(fit(items, 3000)),
    }

    let plan = refine draft by SafePlan retry 1 else {
      Plan { ops: [], answer: "I could not generate a safe plan based on the request." }
    }

    match plan {
      Plan { ops, answer } => {
        for o in ops {
          match o {
            AddLabel { number, label } =>
              commit add_label(repo, number, label),
            Comment { number, body } =>
              commit comment(repo, number, body),
            MergePR { number } =>
              commit merge_pr(repo, number),
            CloseItem { number } =>
              commit close_item(repo, number),
            AddCollaborator { login } =>
              commit add_collaborator(repo, login),
          }
        }
        answer
      },
    }
  }
}
