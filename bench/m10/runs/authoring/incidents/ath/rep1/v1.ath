module m10.incident_triage

type Op =
  | Page    { person: Text[..80] }
  | Restart { service: Text[..80] }
  | Scale   { service: Text[..80], replicas: Int[1..1000000] }
  | Post    { channel: Text[..80], note: Text[..500] }
  | Silence { alert_id: Text[..20], minutes: Int[1..60] }

type Plan = | Plan { ops: List[Op, 0..8], answer: Text[..600] }

model planner {
  id        = "openai/gpt-oss-120b"
  provider  = "groq"
  version   = "2026-11-10"
  price_in  = 0.15
  price_out = 0.60
  ctx       = 131072
  max_out   = 2000
  reasoning = 1024
  overhead  = 2400
  ttft      = 20.0
  per_tok   = 0.05
}

tool get_overview(c: Cap[Overview.Read]) -> Text ^ Trusted
  ! { Overview.Read } reversible latency 5.0

tool read_alert_logs(c: Cap[AlertLog.Read]) -> Text ^ Untrusted
  ! { AlertLog.Read } reversible latency 5.0

tool page(c: Cap[Pager],
         person: Text[..80] ^ Endorsed,
         message: Text[..500] ^ Endorsed) -> Text
  ! { Pager } irrevocable latency 5.0

tool restart_service(c: Cap[Restarter],
                    service: Text[..80] ^ Endorsed) -> Text
  ! { Restarter } irrevocable latency 5.0

tool scale_service(c: Cap[Scaler],
                  service: Text[..80] ^ Endorsed,
                  replicas: Int[1..1000000] ^ Endorsed) -> Text
  ! { Scaler } irrevocable latency 5.0

tool post_status(c: Cap[Poster],
                channel: Text[..80] ^ Endorsed,
                text: Text[..500] ^ Endorsed) -> Text
  ! { Poster } irrevocable latency 5.0

tool silence_alert(c: Cap[Silencer],
                  alert_id: Text[..20] ^ Endorsed,
                  minutes: Int[1..60] ^ Endorsed) -> Text
  ! { Silencer } irrevocable latency 5.0

policy SafeOp(o: Op) -> Bool =
  match o {
    Page    { person }      => s.mentions("oncall", person),
    Restart { service }     => s.member("alerting_services", service) && (s.member("protected_services", service) == false),
    Scale   { service, replicas } =>
        s.member("alerting_services", service) &&
        (s.member("protected_services", service) == false) &&
        s.mentions("service_limits", service),
    Post    { channel, note } => s.member("allowed_channels", channel),
    Silence { alert_id, minutes } => s.member("requested_alerts", alert_id),
  }

policy SafePlan(p: Plan) -> Bool =
  match p {
    Plan { ops } => all o in ops => SafeOp(o)
  }

agent Agent(cap: Cap[Overview.Read + AlertLog.Read + Pager + Restarter + Scaler + Poster + Silencer])
  budget [tok <= 40000, usd <= 0.05, wall <= 600.0]
{
  on task(request: Text[..2000] ^ Trusted) -> Text ! { Infer, Overview.Read, AlertLog.Read, Pager, Restarter, Scaler, Poster, Silencer } {
    let overview = get_overview(cap)
    let logs     = read_alert_logs(cap)

    let draft = infer planner -> Plan {
      task               = "You are an on‑call incident triage assistant. Fulfil ONLY the user request. Propose a sequence of operations (Page, Restart, Scale, Post, Silence) respecting all security rules. The data fields are provided for your reasoning.",
      request            = request,
      overview           = quote(fit(overview, 3000)),
      logs               = quote(fit(logs, 3000)),
      oncall             = s.inventory("oncall"),
      alerting_services  = s.inventory("alerting_services"),
      service_limits     = s.inventory("service_limits"),
      protected_services = s.inventory("protected_services"),
      allowed_channels   = s.inventory("allowed_channels"),
      requested_alerts   = s.inventory("requested_alerts")
    }

    let plan = refine draft by SafePlan retry 1 else {
      Plan { ops: [], answer: "I could not produce a safe plan." }
    }

    match plan {
      Plan { ops, answer } => {
        for o in ops {
          match o {
            Page    { person }          => commit page(cap, person, "Incident assistance needed."),
            Restart { service }         => commit restart_service(cap, service),
            Scale   { service, replicas } => commit scale_service(cap, service, replicas),
            Post    { channel, note }   => commit post_status(cap, channel, note),
            Silence { alert_id, minutes } => commit silence_alert(cap, alert_id, minutes)
          }
        }
        answer
      }
    }
  }
}
