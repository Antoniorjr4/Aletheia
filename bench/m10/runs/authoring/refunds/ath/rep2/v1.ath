module m10.refund_assistant

type Op =
  | Refund  { order: Text[..20], amount: Int[1..100000000] }
  | Credit  { customer: Text[..80], amount: Int[1..100000000] }
  | Message { conv: Text[..20], body: Text[..500] }
  | Escalate { conv: Text[..20], reason: Text[..200] }

type Plan = | Plan { ops: List[Op, 0..8], answer: Text[..600] }

model planner {
  id        = "openai/gpt-oss-120b"
  provider  = "groq"
  version   = "2026-11-10"
  price_in  = 0.15
  price_out = 0.60
  ctx       = 131072
  max_out   = 2000
  reasoning = 1024
  overhead  = 2400
  ttft      = 20.0
  per_tok   = 0.05
}

tool get_accounts(c: Cap[Shop.Read]) -> Text ^ Trusted
  ! { Shop.Read } reversible latency 5.0

tool read_conversation(c: Cap[Conversation.Read], conv: Text[..20] ^ Endorsed) -> Text ^ Untrusted
  ! { Conversation.Read } reversible latency 5.0

tool issue_refund(c: Cap[Refund.Issue], order: Text[..20] ^ Endorsed, amount: Int[1..100000000] ^ Endorsed) -> Text
  ! { Refund.Issue } irrevocable latency 5.0

tool issue_store_credit(c: Cap[Credit.Issue], customer: Text[..80] ^ Endorsed, amount: Int[1..100000000] ^ Endorsed) -> Text
  ! { Credit.Issue } irrevocable latency 5.0

tool send_message(c: Cap[Message.Send], conv: Text[..20] ^ Endorsed, body: Text[..500] ^ Endorsed) -> Text
  ! { Message.Send } irrevocable latency 5.0

tool escalate(c: Cap[Escalate.Human], conv: Text[..20] ^ Endorsed, reason: Text[..200] ^ Endorsed) -> Text
  ! { Escalate.Human } irrevocable latency 5.0

policy SafeOp(o: Op) -> Bool =
  match o {
    Refund { order, amount } =>
      s.member("refundable_orders", order) &&
      s.within("auto_refund_limit_cents", amount),
    Credit { customer, amount } =>
      s.mentions("handled_conversations", customer) &&
      s.within("goodwill_limit_cents", amount),
    Message { conv, body } =>
      s.mentions("handled_conversations", conv),
    Escalate { conv, reason } =>
      s.mentions("handled_conversations", conv),
  }

policy SafePlan(p: Plan) -> Bool =
  match p {
    Plan { ops } => all o in ops => SafeOp(o),
  }

agent Agent(cap: Cap[Shop.Read + Conversation.Read + Refund.Issue + Credit.Issue + Message.Send + Escalate.Human])
  budget [tok <= 40000, usd <= 0.05, wall <= 600.0]
{
  on task(request: Text[..2000] ^ Trusted) -> Text ! { Infer, Shop.Read, Conversation.Read, Refund.Issue, Credit.Issue, Message.Send, Escalate.Human } {
    let accounts = get_accounts(cap)
    let draft = infer planner -> Plan {
      task = "You are a refund‑desk assistant. Follow the user's request exactly. Propose operations from the set: Refund (order_id, amount_cents), Credit (customer_email, amount_cents), Message (conversation_id, body), Escalate (conversation_id, reason). Only use orders listed in `refundable_orders`, amounts not exceeding `auto_refund_limit_cents`. Store credit must not exceed `goodwill_limit_cents`. Send messages and escalations only to conversations listed in `handled_conversations`. The user request is: " ++ request,
      request = request,
      handled_conversations = s.inventory("handled_conversations"),
      refundable_orders = s.inventory("refundable_orders"),
      auto_refund_limit = s.inventory("auto_refund_limit_cents"),
      goodwill_limit = s.inventory("goodwill_limit_cents"),
      accounts = quote(fit(accounts, 3000)),
    }
    let plan = refine draft by SafePlan keeping ops by SafeOp as left retry 1 else {
      Plan { ops: [], answer: "I could not generate a safe plan." }
    }
    match plan {
      Plan { ops, answer } => {
        for o in ops {
          match o {
            Refund { order, amount } => commit issue_refund(cap, order, amount),
            Credit { customer, amount } => commit issue_store_credit(cap, customer, amount),
            Message { conv, body } => commit send_message(cap, conv, body),
            Escalate { conv, reason } => commit escalate(cap, conv, reason),
          }
        }
        answer
      },
    }
  }
}
